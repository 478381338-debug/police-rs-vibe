# 复制为 .env 后按部署环境修改；不要把真实密钥提交到仓库。
# Docker Compose 会自动读取同目录的 .env。

# 演示模式：生产必须设为 0，并修改演示账号密码。
POLICE_DEMO_MODE=1

# 演示站访问口令；两项都设置才启用 HTML 口令页，留空则公开。
POLICE_WEB_USER=
POLICE_WEB_PASSWORD=
POLICE_GATE_HOURS=12

# 对外访问地址，用于生成移动端到场码链接和二维码。
# 例如 https://police.example.gov.cn
POLICE_PUBLIC_BASE_URL=

# HTTPS 部署时设为 1，让会话 Cookie 带 Secure。
POLICE_COOKIE_SECURE=0

# 只有确认请求经过可信反向代理时才设为 1；否则限流会信任伪造的 X-Forwarded-For。
POLICE_TRUST_PROXY=0

# HTTPS 且确认全站强制 HTTPS 后再设为 1。
POLICE_HSTS=0

# 生产环境建议设为 1，关闭 /docs、/redoc、/openapi.json。
POLICE_DISABLE_DOCS=0

# 额外允许的跨域来源，逗号分隔；同源部署留空。
POLICE_CORS_ORIGINS=

# 证据链 HMAC 密钥。留空时自动生成到 instance/.evidence_key。
# 生产建议用独立密钥管理系统注入，并与数据库分开备份。
POLICE_EVIDENCE_KEY=

# 单份证据上限（MB）。
POLICE_MAX_EVIDENCE_MB=50

# 限流参数（单进程内存计数；多副本部署应在网关层统一限流）。
POLICE_RATE_LOGIN_PER_MIN=10
POLICE_RATE_API_PER_MIN=300
POLICE_RATE_EXPENSIVE_PER_MIN=30
POLICE_RATE_REFRESH_PER_5MIN=6

# OSRM 路由服务；公共实例无 SLA，生产应换成自建或签约服务。
POLICE_OSRM_BASE=https://router.project-osrm.org
POLICE_OSRM_CENTER_SNAP_M=2000
POLICE_OSRM_DEST_SNAP_M=1500

# 无人机航线航点上限与范围上限。
POLICE_DRONE_MAX_WAYPOINTS=800
POLICE_DRONE_MAX_SIZE_KM=5

# 实例目录；Docker 中默认为 /app/instance。
POLICE_INSTANCE_DIR=